{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vi Drop",
  "version": "1.0.1",
  "identifier": "com.vidrop.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vi Drop - Nhận File An Toàn Qua Wi-Fi",
        "width": 1020,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQkU5NzY5OEJBMjA5RDcKUldUWENhS0xhWmUrblFNSWwwMVhiUGZHaXk4OWhQcGVWNERzUU1XVFA0TU9zbTg3MUwwRTVlblQK",
      "endpoints": [
        "https://github.com/PhanThanh07/ViDrop/releases/latest/download/latest.json"
      ]
    }
  }
}
